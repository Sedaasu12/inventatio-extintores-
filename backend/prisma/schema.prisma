// Esquema de datos de SITE (fase 1).
// Fuente: docs/modelo-entidad-relacion.md.
//
// MySQL 8 / InnoDB. Eventos en UTC; fechas calendario como DATE.
// Las restricciones CHECK, la columna generada `maintenance_orders.active_key`
// y sus índices se agregan en la migración SQL manual
// (`prisma/migrations/0001_init/migration.sql`), porque Prisma no las expresa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

enum LocationType {
  SEDE
  ALMACEN
  AREA
  TALLER
}

enum LogisticsStatus {
  EN_ALMACEN
  ASIGNADO
  EN_MANTENIMIENTO
  DADO_DE_BAJA
}

enum TechnicalCondition {
  OPERATIVO
  OBSERVADO
  NO_OPERATIVO
  PENDIENTE_INSPECCION
}

enum PlacementType {
  INTERNAL
  EXTERNAL
  NONE
}

enum MovementType {
  INGRESO
  SALIDA
  TRASLADO
  RETORNO_ALMACEN
  ENVIO_MANTENIMIENTO
  RETORNO_MANTENIMIENTO
  BAJA
  AJUSTE
}

enum EntrySource {
  COMPRA_CENTRAL
  COMPRA_LOCAL
  CARGA_INICIAL
  RETORNO_MANTENIMIENTO
  TRASLADO
}

enum MovementEndpointKind {
  LOCATION
  EXTERNAL_PARTY
  NONE
}

enum MaintenanceOrderStatus {
  ABIERTA
  EN_PROVEEDOR
  CERRADA
  CANCELADA
}

enum ServiceType {
  MANTENIMIENTO
  RECARGA
  REPARACION
  PRUEBA_HIDROSTATICA
}

enum ServiceResult {
  APROBADO
  APROBADO_CON_OBSERVACIONES
  RECHAZADO
}

enum InspectionResult {
  APROBADO
  APROBADO_CON_OBSERVACIONES
  RECHAZADO
}

enum DueDateEventType {
  EQUIPO
  INSPECCION
  MANTENIMIENTO
  RECARGA
  PRUEBA_HIDROSTATICA
}

enum DueDateSourceType {
  EXTINGUISHER
  INSPECTION
  MAINTENANCE_SERVICE
}

enum ExternalPartyType {
  PROVEEDOR_MANTENIMIENTO
  TALLER
  PROVEEDOR
  OTRO
}

enum CapacityUnit {
  KG
  L
  LB
}

enum CaptureMode {
  ONLINE
  OFFLINE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

// ---------------------------------------------------------------------------
// Identidad y acceso
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @db.Char(36)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(150)
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts") @db.UnsignedInt
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(3)
  createdById         String?   @map("created_by") @db.Char(36)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deactivatedAt       DateTime? @map("deactivated_at") @db.DateTime(3)

  createdBy            User?                @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers         User[]               @relation("UserCreatedBy")
  userRoles            UserRole[]
  assignedUserRoles    UserRole[]           @relation("UserRoleAssignedBy")
  refreshTokens        RefreshToken[]
  idempotencyRecords   IdempotencyRecord[]
  locationsCreated     Location[]           @relation("LocationCreatedBy")
  extinguishersCreated Extinguisher[]       @relation("ExtinguisherCreatedBy")
  devices              Device[]             @relation("DeviceAssignedUser")
  movementsCreated     Movement[]           @relation("MovementCreatedBy")
  ordersCreated        MaintenanceOrder[]   @relation("MaintenanceOrderCreatedBy")
  servicesPerformed    MaintenanceService[] @relation("ServicePerformedBy")
  servicesCreated      MaintenanceService[] @relation("ServiceCreatedBy")
  inspectionsPerformed Inspection[]         @relation("InspectionInspector")
  inspectionsCreated   Inspection[]         @relation("InspectionCreatedBy")
  alertSettingsUpdated AlertSetting[]       @relation("AlertSettingUpdatedBy")
  auditLogs            AuditLog[]           @relation("AuditLogActor")

  @@index([active])
  @@index([deactivatedAt])
  @@map("users")
}

model Role {
  id          String  @id @db.Char(36)
  code        String  @unique @db.VarChar(30)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @db.Char(36)
  code        String  @unique @db.VarChar(60)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  assignedById String?  @map("assigned_by") @db.Char(36)

  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id           String    @id @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Char(36)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model IdempotencyRecord {
  id             String            @id @db.Char(36)
  userId         String            @map("user_id") @db.Char(36)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(64)
  method         String            @db.VarChar(10)
  path           String            @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus
  responseStatus Int?              @map("response_status") @db.SmallInt
  resourceType   String?           @map("resource_type") @db.VarChar(50)
  resourceId     String?           @map("resource_id") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt      DateTime          @map("expires_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@index([resourceType, resourceId])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Ubicaciones y catálogos
// ---------------------------------------------------------------------------

model Location {
  id          String       @id @db.Char(36)
  code        String       @unique @db.VarChar(30)
  name        String       @db.VarChar(150)
  type        LocationType
  parentId    String?      @map("parent_id") @db.Char(36)
  address     String?      @db.VarChar(255)
  active      Boolean      @default(true)
  createdById String?      @map("created_by") @db.Char(36)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  parent              Location?          @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Location[]         @relation("LocationHierarchy")
  createdBy           User?              @relation("LocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  extinguishers       Extinguisher[]     @relation("ExtinguisherCurrentLocation")
  movementsOrigin     Movement[]         @relation("MovementOriginLocation")
  movementsDestination Movement[]        @relation("MovementDestinationLocation")
  maintenanceOrders   MaintenanceOrder[] @relation("MaintenanceOrderWorkshop")

  @@unique([parentId, name])
  @@index([parentId])
  @@index([type])
  @@index([active])
  @@map("locations")
}

model ExtinguisherType {
  id              String       @id @db.Char(36)
  code            String       @unique @db.VarChar(20)
  name            String       @db.VarChar(100)
  agent           String       @db.VarChar(60)
  nominalCapacity Decimal      @map("nominal_capacity") @db.Decimal(10, 2)
  capacityUnit    CapacityUnit @map("capacity_unit")
  usefulLifeYears Int?         @map("useful_life_years") @db.UnsignedSmallInt
  description     String?      @db.VarChar(500)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  extinguishers Extinguisher[]

  @@index([active])
  @@map("extinguisher_types")
}

model ExternalParty {
  id          String            @id @db.Char(36)
  code        String            @unique @db.VarChar(30)
  name        String            @db.VarChar(150)
  partyType   ExternalPartyType @map("party_type")
  taxId       String?           @map("tax_id") @db.VarChar(20)
  contactName String?           @map("contact_name") @db.VarChar(150)
  phone       String?           @db.VarChar(30)
  email       String?           @db.VarChar(255)
  address     String?           @db.VarChar(255)
  active      Boolean           @default(true)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  extinguishers       Extinguisher[]        @relation("ExtinguisherCurrentExternalParty")
  movementsOrigin     Movement[]            @relation("MovementOriginExternalParty")
  movementsDestination Movement[]           @relation("MovementDestinationExternalParty")
  maintenanceOrders   MaintenanceOrder[]    @relation("MaintenanceOrderProvider")
  maintenanceServices MaintenanceService[]  @relation("ServiceProvider")

  @@index([active])
  @@index([partyType])
  @@index([name])
  @@map("external_parties")
}

model Device {
  id             String    @id @db.Char(36)
  code           String    @unique @db.VarChar(30)
  label          String    @db.VarChar(100)
  assignedUserId String    @map("assigned_user_id") @db.Char(36)
  lastSyncAt     DateTime? @map("last_sync_at") @db.DateTime(3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  assignedUser User          @relation("DeviceAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  movements    Movement[]
  inspections  Inspection[]

  @@index([assignedUserId, active])
  @@index([lastSyncAt])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Activo y trazabilidad
// ---------------------------------------------------------------------------

model Extinguisher {
  id                     String             @id @db.Char(36)
  assetCode              String             @unique @map("asset_code") @db.VarChar(20)
  serialNumber           String?            @map("serial_number") @db.VarChar(100)
  typeId                 String             @map("type_id") @db.Char(36)
  brand                  String?            @db.VarChar(100)
  model                  String?            @db.VarChar(100)
  capacityValue          Decimal            @map("capacity_value") @db.Decimal(10, 2)
  capacityUnit           CapacityUnit       @map("capacity_unit")
  manufactureDate        DateTime?          @map("manufacture_date") @db.Date
  acquiredAt             DateTime?          @map("acquired_at") @db.Date
  commissionedAt         DateTime?          @map("commissioned_at") @db.Date
  manufacturerExpiryDate DateTime?          @map("manufacturer_expiry_date") @db.Date
  logisticsStatus        LogisticsStatus    @map("logistics_status")
  technicalCondition     TechnicalCondition @map("technical_condition")
  placementType          PlacementType      @map("placement_type")
  currentLocationId      String?            @map("current_location_id") @db.Char(36)
  currentExternalPartyId String?            @map("current_external_party_id") @db.Char(36)
  currentSince           DateTime?          @map("current_since") @db.DateTime(3)
  retiredAt              DateTime?          @map("retired_at") @db.DateTime(3)
  retirementReason       String?            @map("retirement_reason") @db.VarChar(500)
  notes                  String?            @db.Text
  rowVersion             Int                @default(1) @map("row_version") @db.UnsignedInt
  createdById            String             @map("created_by") @db.Char(36)
  createdAt              DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  type                 ExtinguisherType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  currentLocation      Location?           @relation("ExtinguisherCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentExternalParty ExternalParty?      @relation("ExtinguisherCurrentExternalParty", fields: [currentExternalPartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy            User                @relation("ExtinguisherCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  movements            Movement[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceServices  MaintenanceService[]
  inspections          Inspection[]
  dueDates             DueDate[]

  @@index([serialNumber])
  @@index([currentLocationId, logisticsStatus])
  @@index([currentExternalPartyId])
  @@index([logisticsStatus])
  @@index([technicalCondition])
  @@index([typeId])
  @@index([manufacturerExpiryDate])
  @@index([createdAt])
  @@map("extinguishers")
}

model Movement {
  id                        String               @id @db.Char(36)
  extinguisherId            String               @map("extinguisher_id") @db.Char(36)
  assetSequence             Int                  @map("asset_sequence") @db.UnsignedInt
  movementType              MovementType         @map("movement_type")
  entrySource               EntrySource?         @map("entry_source")
  originKind                MovementEndpointKind @map("origin_kind")
  originLocationId          String?              @map("origin_location_id") @db.Char(36)
  originExternalPartyId     String?              @map("origin_external_party_id") @db.Char(36)
  originLabel               String               @map("origin_label") @db.VarChar(255)
  destinationKind           MovementEndpointKind @map("destination_kind")
  destinationLocationId     String?              @map("destination_location_id") @db.Char(36)
  destinationExternalPartyId String?             @map("destination_external_party_id") @db.Char(36)
  destinationLabel          String               @map("destination_label") @db.VarChar(255)
  movedAt                   DateTime             @map("moved_at") @db.DateTime(3)
  requestedBy               String?              @map("requested_by") @db.VarChar(150)
  authorizedBy              String?              @map("authorized_by") @db.VarChar(150)
  deliveredBy               String?              @map("delivered_by") @db.VarChar(150)
  receivedBy                String?              @map("received_by") @db.VarChar(150)
  reason                    String               @db.VarChar(500)
  documentRef               String?              @map("document_ref") @db.VarChar(100)
  notes                     String?              @db.Text
  correctsMovementId        String?              @map("corrects_movement_id") @db.Char(36)
  createdById               String               @map("created_by") @db.Char(36)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  clientUuid                String?              @unique @map("client_uuid") @db.Char(36)
  captureMode               CaptureMode          @default(ONLINE) @map("capture_mode")
  deviceId                  String?              @map("device_id") @db.Char(36)
  syncedAt                  DateTime?            @map("synced_at") @db.DateTime(3)

  extinguisher            Extinguisher        @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)
  originLocation          Location?           @relation("MovementOriginLocation", fields: [originLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  originExternalParty     ExternalParty?      @relation("MovementOriginExternalParty", fields: [originExternalPartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinationLocation     Location?           @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  destinationExternalParty ExternalParty?     @relation("MovementDestinationExternalParty", fields: [destinationExternalPartyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correctsMovement        Movement?           @relation("MovementCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict)
  corrections             Movement[]          @relation("MovementCorrection")
  createdBy               User                @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  device                  Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  maintenanceOrderSent    MaintenanceOrder?   @relation("MaintenanceOrderSentMovement")
  maintenanceOrderReturn  MaintenanceOrder?   @relation("MaintenanceOrderReturnMovement")

  @@unique([extinguisherId, assetSequence])
  @@index([extinguisherId, movedAt])
  @@index([movementType, movedAt])
  @@index([originLocationId])
  @@index([destinationLocationId])
  @@index([originExternalPartyId])
  @@index([destinationExternalPartyId])
  @@index([createdById, createdAt])
  @@index([deviceId, syncedAt])
  @@index([createdAt])
  @@map("movements")
}

model MaintenanceOrder {
  id                 String                 @id @db.Char(36)
  extinguisherId     String                 @map("extinguisher_id") @db.Char(36)
  providerId         String?                @map("provider_id") @db.Char(36)
  workshopLocationId String?                @map("workshop_location_id") @db.Char(36)
  status             MaintenanceOrderStatus
  sentMovementId     String                 @unique @map("sent_movement_id") @db.Char(36)
  returnMovementId   String?                @unique @map("return_movement_id") @db.Char(36)
  openedAt           DateTime               @map("opened_at") @db.DateTime(3)
  expectedReturnDate DateTime?              @map("expected_return_date") @db.Date
  closedAt           DateTime?              @map("closed_at") @db.DateTime(3)
  reason             String                 @db.VarChar(500)
  authorizedBy       String?                @map("authorized_by") @db.VarChar(150)
  documentRef        String?                @map("document_ref") @db.VarChar(100)
  notes              String?                @db.Text
  createdById        String                 @map("created_by") @db.Char(36)
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  extinguisher     Extinguisher         @relation(fields: [extinguisherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider         ExternalParty?       @relation("MaintenanceOrderProvider", fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workshopLocation Location?            @relation("MaintenanceOrderWorkshop", fields: [workshopLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sentMovement     Movement             @relation("MaintenanceOrderSentMovement", fields: [sentMovementId], references: [id], onDelete: Restrict)
  returnMovement   Movement?            @relation("MaintenanceOrderReturnMovement", fields: [returnMovementId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation("MaintenanceOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  services         MaintenanceService[]

  @@index([extinguisherId, status])
  @@index([providerId])
  @@index([workshopLocationId])
  @@index([expectedReturnDate])
  @@map("maintenance_orders")
}

model MaintenanceService {
  id                 String        @id @db.Char(36)
  extinguisherId     String        @map("extinguisher_id") @db.Char(36)
  maintenanceOrderId String?       @map("maintenance_order_id") @db.Char(36)
  serviceType        ServiceType   @map("service_type")
  performedAt        DateTime      @map("performed_at") @db.DateTime(3)
  performedOn        DateTime      @map("performed_on") @db.Date
  performedByUserId  String?       @map("performed_by_user_id") @db.Char(36)
  providerId         String?       @map("provider_id") @db.Char(36)
  result             ServiceResult
  certificateNo      String?       @map("certificate_no") @db.VarChar(100)
  certificateDate    DateTime?     @map("certificate_date") @db.Date
  nextDueDate        DateTime?     @map("next_due_date") @db.Date
  cost               Decimal?      @db.Decimal(12, 2)
  currency           String?       @db.Char(3)
  notes              String?       @db.Text
  documentRef        String?       @map("document_ref") @db.VarChar(100)
  correctsId         String?       @map("corrects_id") @db.Char(36)
  createdById        String        @map("created_by") @db.Char(36)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  extinguisher     Extinguisher        @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)
  maintenanceOrder MaintenanceOrder?   @relation(fields: [maintenanceOrderId], references: [id], onDelete: Restrict)
  performedByUser  User?               @relation("ServicePerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  provider         ExternalParty?      @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Restrict)
  corrects         MaintenanceService? @relation("ServiceCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections      MaintenanceService[] @relation("ServiceCorrection")
  createdBy        User                @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([extinguisherId, performedAt])
  @@index([serviceType, nextDueDate])
  @@index([maintenanceOrderId])
  @@index([providerId])
  @@index([nextDueDate])
  @@map("maintenance_services")
}

model Inspection {
  id             String           @id @db.Char(36)
  extinguisherId String           @map("extinguisher_id") @db.Char(36)
  inspectedAt    DateTime         @map("inspected_at") @db.DateTime(3)
  inspectedOn    DateTime         @map("inspected_on") @db.Date
  inspectorUserId String?         @map("inspector_user_id") @db.Char(36)
  inspectorName  String           @map("inspector_name") @db.VarChar(150)
  result         InspectionResult
  checklistJson  Json?            @map("checklist_json") @db.Json
  nextDueDate    DateTime?        @map("next_due_date") @db.Date
  notes          String?          @db.Text
  documentRef    String?          @map("document_ref") @db.VarChar(100)
  correctsId     String?          @map("corrects_id") @db.Char(36)
  createdById    String           @map("created_by") @db.Char(36)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  clientUuid     String?          @unique @map("client_uuid") @db.Char(36)
  captureMode    CaptureMode      @default(ONLINE) @map("capture_mode")
  deviceId       String?          @map("device_id") @db.Char(36)
  syncedAt       DateTime?        @map("synced_at") @db.DateTime(3)

  extinguisher   Extinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)
  inspectorUser  User?        @relation("InspectionInspector", fields: [inspectorUserId], references: [id], onDelete: Restrict)
  corrects       Inspection?  @relation("InspectionCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections    Inspection[] @relation("InspectionCorrection")
  createdBy      User         @relation("InspectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  device         Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([extinguisherId, inspectedAt])
  @@index([nextDueDate])
  @@index([inspectorUserId])
  @@index([result])
  @@index([deviceId, syncedAt])
  @@map("inspections")
}

model DueDate {
  id            String            @id @db.Char(36)
  extinguisherId String           @map("extinguisher_id") @db.Char(36)
  eventType     DueDateEventType  @map("event_type")
  dueDate       DateTime          @map("due_date") @db.Date
  sourceType    DueDateSourceType @map("source_type")
  sourceId      String            @map("source_id") @db.Char(36)
  sourceEventAt DateTime?         @map("source_event_at") @db.DateTime(3)
  recordedAt    DateTime          @default(now()) @map("recorded_at") @db.DateTime(3)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  extinguisher Extinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Restrict)

  @@unique([extinguisherId, eventType])
  @@index([eventType, dueDate])
  @@index([dueDate])
  @@index([sourceType, sourceId])
  @@map("due_dates")
}

model AlertSetting {
  id          String           @id @db.Char(36)
  eventType   DueDateEventType @unique @map("event_type")
  daysBefore  Int?             @map("days_before")
  enabled     Boolean          @default(true)
  updatedById String           @map("updated_by") @db.Char(36)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User @relation("AlertSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("alert_settings")
}

model AuditLog {
  id           String   @id @db.Char(36)
  actorUserId  String?  @map("actor_user_id") @db.Char(36)
  actorLabel   String   @map("actor_label") @db.VarChar(255)
  action       String   @db.VarChar(80)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.Char(36)
  beforeData   Json?    @map("before_data") @db.Json
  afterData    Json?    @map("after_data") @db.Json
  ip           String?  @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  requestId    String?  @map("request_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model CodeCounter {
  id        String   @id @db.Char(36)
  scope     String   @unique @db.VarChar(30)
  prefix    String   @db.VarChar(10)
  nextValue Int      @map("next_value") @db.UnsignedInt
  padding   Int      @db.UnsignedTinyInt
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("code_counters")
}
