# Copia este archivo a `.env` en la raíz. No lo subas al repositorio.
# El backend lee `.env` y `../.env`; las variables reales de producción
# se inyectan por el entorno del servidor.

NODE_ENV=development
PORT=3000
TZ=America/Lima

# Conexión usada por el backend y por Prisma.
DATABASE_URL=mysql://site:site@localhost:3306/site

# Autenticación (fase 2). Genera un secreto local, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción es obligatorio y debe tener al menos 32 caracteres.
JWT_ACCESS_SECRET=development-only-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Cookies `Secure`: false en desarrollo por HTTP, true en producción por HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Resolución de QR/código (fase 4): por usuario y por IP en la ventana indicada.
RATE_LIMIT_QR_USER=60
RATE_LIMIT_QR_IP=300
RATE_LIMIT_QR_WINDOW_SECONDS=60

# Credenciales del contenedor MySQL de desarrollo (no usar en producción).
# Si el puerto 3306 está ocupado, cambia MYSQL_PORT y el puerto de DATABASE_URL
# en tu `.env` local (por ejemplo 3307).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=site
MYSQL_USER=site
MYSQL_PASSWORD=site
MYSQL_PORT=3306
